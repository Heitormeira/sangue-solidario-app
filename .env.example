# Copie este arquivo para ".env" e preencha com as chaves do Back4App.
# São os MESMOS valores das variáveis NEXT_PUBLIC_ do site (Vercel).
# Back4App > App Settings > Security & Encryption.
#
# Atenção: tudo que começa com EXPO_PUBLIC_ vai junto no app (é público).
# Quem protege os dados é o ACL de cada registro, não o segredo da chave.
EXPO_PUBLIC_BACK4APP_APP_ID=SEU_APPLICATION_ID_AQUI
EXPO_PUBLIC_BACK4APP_JAVASCRIPT_KEY=SUA_JAVASCRIPT_KEY_AQUI
